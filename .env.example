# Copy to .env, then enter your internal OpenAI-compatible endpoint and model ID.
# The app and --glm benchmark load .env; shell settings take precedence.
# No API is called until both endpoint and model are configured.
# Example endpoint: https://your-internal-api.example/v1
# A full .../v1/chat/completions URL also works.
GLM_BASE_URL=
# Example model: glm-5.3-flash (use your gateway's exact ID; no substitution).
GLM_MODEL=
# Leave empty if your internal API does not require Bearer authentication.
GLM_API_KEY=
GLM_TIMEOUT_SECONDS=20
# Optional gateway-specific headers. Values must be strings (shell-quote JSON).
GLM_HEADERS_JSON='{}'
# Optional: set only if your gateway supports reasoning_effort (low/high/max).
GLM_REASONING_EFFORT=
# ZAI_API_KEY is accepted as an alias when GLM_API_KEY is absent.
